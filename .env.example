# Web Crawler Acquisition Module - Environment Configuration
# Copy this file to .env to customize settings. Secrets should never be committed.

CRAWLER_USER_AGENT="AcademicCrawler/1.0 (+https://academic-research.org/bot; crawler-contact@academic-research.org)"
CRAWLER_CONTACT_EMAIL="crawler-contact@academic-research.org"
CRAWLER_MAX_CONCURRENCY=10
CRAWLER_PER_HOST_DELAY_SEC=1.0
CRAWLER_REQUEST_TIMEOUT_SEC=15.0
CRAWLER_CONNECT_TIMEOUT_SEC=5.0
CRAWLER_MAX_RETRIES=3
CRAWLER_BACKOFF_FACTOR=1.5
CRAWLER_MAX_RESPONSE_SIZE_BYTES=10485760 # 10 MB
CRAWLER_MAX_ROBOTS_SIZE_BYTES=524288 # 512 KB
CRAWLER_MAX_REDIRECTS=5
CRAWLER_STATE_DB_PATH="crawl_state.db"

# Safety settings: Set to 'true' ONLY in controlled test environments
CRAWLER_ALLOW_PRIVATE_IPS=false
